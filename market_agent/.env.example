# Copy this to .env or export these variables in your shell

# 1. Telegram Bot Token from @BotFather (e.g., 7123456789:ABCdefGHIjklMNOpqrSTUvwxYZ)
TELEGRAM_BOT_TOKEN=

# 2. Telegram Your Personal Chat ID from @userinfobot (e.g., 123456789)
TELEGRAM_CHAT_ID=

# 3. Optional: Free Google Gemini API Key from https://aistudio.google.com/
# If provided, Gemini generates human-grade executive summaries & connects dots between tech tools and markets.
# If omitted, the agent uses its built-in rule-based template.
GEMINI_API_KEY=

# 4. Schedule interval in hours (Default: 4)
SCHEDULE_INTERVAL_HOURS=4

